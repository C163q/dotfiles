# Old configuration files and backups.
*.old
*.bak

# Neovim's plugin lockfile is excluded because it changes frequently.
# Plugin sources and version constraints are declared in the Lua configuration.
nvim/config/lazy-lock.json

# Local Neovim assets and legacy configurations.
nvim/config/assets/
nvim/legacy/

# Environment-specific Zsh configuration.
**/.zshrc.*
zsh/config/local/

# Local files and generated state.
nvim/.exrc
vim/.vim/.netrwhist

# Vim plugins installed with :PlugInstall.
vim/.vim/plugged/

# Yazi flavors and plugins managed by the official package manager.
yazi/flavors/
yazi/plugins/

# whoosh is managed separately as a Git submodule.
!yazi/plugins/whoosh.yazi/

# Keep yazi/package.toml under version control to record flavor and plugin dependencies.
#
# Commit changes only when intentionally adding, removing, or updating dependencies.
#
# Unlike Neovim's Lua plugin specifications, this file serves as the dependency
# list for Yazi's package manager.
# yazi/package.toml

# Fastfetch's config.jsonc symlink selects the configuration for the current terminal.
# Terminal-specific configurations are stored in fastfetch/config/.
fastfetch/config.jsonc
